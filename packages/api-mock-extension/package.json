{
  "name": "api-mock-extension",
  "version": "1.0.0",
  "description": "A browser extension for mocking API responses",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev:extension": "vite build --mode development --watch",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:extension\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
    "clean": "rimraf dist"
  },
  "watch": {
    "build": {
      "patterns": [
        "src",
        "manifest.json"
      ],
      "extensions": "ts,tsx,scss,json",
      "quiet": false
    }
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "packageManager": "pnpm@9.14.2",
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@types/jsonpath": "^0.2.4",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "sass": "^1.83.4",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  },
  "dependencies": {
    "@types/classnames": "^2.3.4",
    "classnames": "^2.2.6",
    "jsonpath": "^1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-router-dom": "^7.1.5",
    "xml-js": "^1.6.11",
    "yaml": "^2.7.0"
  }
}