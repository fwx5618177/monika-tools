{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "install": "pnpm install",
    "test": "mocha",
    "dev": "node --dns-result-order=ipv4first -r ts-node/register ./src/main.ts",
    "build": "tsc -p tsconfig.json",
    "clean:cache": "rimraf ./dist ./node_modules/.cache",
    "clean": "pnpm run clean:cache && rimraf node_modules && pnpm install",
    "lint": "eslint --ext .ts ./src",
    "lint:fix": "eslint --fix --ext .ts ./src",
    "prettier": "prettier --write \"src/**/*.ts\"",
    "prettier:check": "prettier --check \"src/**/*.ts\"",
    "prettier:write": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "discord.js": "^14.13.0",
    "node-telegram-bot-api": "^0.63.0",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.1"
  },
  "engines": {
    "node": ">=20.6.1"
  },
  "devDependencies": {
    "@types/chai": "^4.3.9",
    "@types/mocha": "^10.0.3",
    "@types/node": "^20.8.7",
    "@types/node-telegram-bot-api": "^0.61.11",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "chai": "^4.3.10",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "mocha": "^10.2.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  }
}