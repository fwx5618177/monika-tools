{
  "name": "torrent-cli",
  "version": "0.0.1",
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/fwx5618177/torrent-cli"
  },
  "author": "fwx5618177",
  "main": "dist/cli.js",
  "bin": {
    "torrent-cli": "dist/cli.js"
  },
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "clean": "pnpm run -r clean && pnpm run clean:cache && rimraf **/*/node_modules ./node_modules **/*/pnpm-lock.yaml ./pnpm-lock.yaml",
    "clean:cache": "rimraf ./dist ./src/dist ./src/**/*/dist ./scripts/dist ./node_modules/.cache",
    "lint": "eslint --ignore-path .gitignore --ext .ts .",
    "lint:fix": "eslint --ignore-path .gitignore --ext .ts --fix .",
    "prettier": "prettier --ignore-path .gitignore --write \"**/*.ts\"",
    "start": "ts-node -r tsconfig-paths/register --transpile-only cli.ts",
    "build": "pnpm recursive run build && tsc --resolveJsonModule -p tsconfig.json",
    "cli": "pnpm run clean:cache && pnpm run build && node ./dist/cli.js",
    "release": "semantic-release",
    "test": "pnpm -r run test"
  },
  "keywords": [],
  "engines": {
    "node": ">= 20.6.1",
    "pnpm": ">=8.0.0"
  },
  "license": "ISC",
  "dependencies": {
    "@torrent-cli/core": "workspace:^",
    "commander": "^11.0.0",
    "dayjs": "^1.11.10",
    "rimraf": "^5.0.5",
    "semantic-release": "^22.0.5",
    "tslib": "^2.6.2"
  },
  "workspaces": [
    "benchmark/*",
    "packages/*",
    "src/*"
  ],
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.5",
    "@rollup/plugin-json": "^6.0.1",
    "@rollup/plugin-multi-entry": "^6.0.1",
    "@rollup/plugin-node-resolve": "^15.2.2",
    "@rollup/plugin-typescript": "^11.1.5",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.0.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.1",
    "@semantic-release/npm": "^11.0.0",
    "@semantic-release/release-notes-generator": "^12.0.0",
    "@types/chai": "^4.3.6",
    "@types/inquirer": "^9.0.3",
    "@types/mocha": "^10.0.2",
    "@types/node": "^20.8.3",
    "@types/sinon": "^10.0.19",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/typescript-estree": "^6.7.4",
    "chai": "^4.3.10",
    "chalk": "^4.1.2",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "file-type": "^18.5.0",
    "inquirer": "^8.2.6",
    "lint-staged": "^13.3.0",
    "mocha": "^10.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "read-chunk": "^4.0.3",
    "rollup": "^3.29.4",
    "rollup-plugin-delete": "^2.0.0",
    "sinon": "^16.1.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}