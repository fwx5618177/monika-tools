{
    "extensions": [
        "ts"
    ],
    "require": [
        "ts-node/register",
        "tsconfig-paths/register"
    ],
    "spec": [
        "src/**/*.spec.[t|j]s",
        "src/**/*.spec.[c|m]js",
        "tests/**/*.spec.[c|m]js",
        "tests/**/*.spec.[t|j]s"
    ],
    "loader": "ts-node/esm",
    "node-option": [
        "experimental-specifier-resolution=node",
        "loader=ts-node/esm"
    ],
    "parallel": true
}