# Step 1: Use an official nginx base image
FROM nginx:alpine

# Step 2: Copy the build output from the React app to the Nginx web server
COPY ../dist /usr/share/nginx/html

# Step 3: Copy your custom nginx.conf file to the Nginx configuration directory
COPY ./nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Start Nginx server
CMD ["nginx", "-g", "daemon off;"]