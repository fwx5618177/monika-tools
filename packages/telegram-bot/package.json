{
  "name": "telegram-bot",
  "version": "1.0.0",
  "description": "",
  "main": "src/main.ts",
  "type": "module",
  "scripts": {
    "prepare": "husky install",
    "preinstall": "npx -y only-allow pnpm",
    "test": "mocha --import=tsx 'src/**/*.spec.ts' 'tests/**/*.spec.ts'",
    "dev": "cross-env NODE_ENV=development DEBUG=backend:* nodemon",
    "start": "cross-env NODE_ENV=production node --import tsx dist/main.js",
    "pub:beta": "npm version prerelease --preid=beta",
    "pub:patch": "npm version patch",
    "pub:preminor": "npm version preminor --preid=alpha",
    "pub:release": "semantic-release",
    "type-check": "tsc --noEmit",
    "rm": "rimraf dist",
    "build": "swc src -d dist --source-maps -D --strip-leading-paths",
    "build:clean": "npm run rm && npm run build",
    "build:prod": "npm run rm && npm run type-check && npm run build",
    "lint": "eslint --ignore-path .gitignore --ext .ts,.js . --cache --debug",
    "lint:fix": "eslint --ignore-path .gitignore --ext .ts,.js --fix . --cache --debug",
    "prettier": "prettier --ignore-path .gitignore --write \"**/*.{ts,js}\"",
    "doc": "typedoc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^12.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.0.2",
    "@semantic-release/release-notes-generator": "^13.0.0",
    "@swc/cli": "^0.3.12",
    "@swc/core": "^1.4.11",
    "@types/chai": "^4.3.14",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.12.2",
    "@types/sinon": "^17.0.3",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "chai": "^5.1.0",
    "chalk": "^5.3.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "https-proxy-agent": "^7.0.4",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "mocha": "^10.4.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "semantic-release": "^23.0.7",
    "sinon": "^17.0.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.7.1",
    "typedoc": "^0.25.12",
    "typescript": "^5.4.3"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "fluent-ffmpeg": "^2.1.2",
    "node-telegram-bot-api": "^0.65.1",
    "sanitize-filename": "^1.6.3",
    "telegraf": "^4.16.3",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}